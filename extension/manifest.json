{
  "manifest_version": 3,
  "name": "MusicPuller - Suno Direct Lossless Grabber",
  "version": "1.0",
  "description": "Intercepts direct Suno audio streams bit-for-bit and saves lossless tracks directly to your MusicPuller folder.",
  "permissions": [
    "webRequest",
    "cookies",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://suno.com/*",
    "https://*.suno.ai/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MusicPuller Suno Stream Grabber"
  }
}
